# Public site URL (used for canonical URLs, sitemap, Open Graph).
# Local: http://localhost:3000  | Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 6) ---
# Dashboard > Project Settings > API Keys. These two are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects may still use the legacy "anon" key. It works in the same place:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-SIDE ONLY (never NEXT_PUBLIC_). Needed only for the "Delete account" button.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (Phase 5) ---
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Create a key in Google AI Studio.
GEMINI_API_KEY=
# Optional. Pin a specific model id from the Gemini docs. Default: gemini-flash-latest
GEMINI_MODEL=
# Optional per-visitor limits (per server instance). Defaults: 8 per minute, 60 per day
AI_RATE_LIMIT_PER_MINUTE=
AI_RATE_LIMIT_PER_DAY=

# --- Site, contact, ads and security (Phase 7) ---
# Public contact address shown on the Contact page (leave empty to hide the form)
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to true only when you connect an ad network (shows placeholder slots in development)
NEXT_PUBLIC_ADS_ENABLED=false
# Content-Security-Policy: enforce (default) | report-only | off
CSP_MODE=enforce
